---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Contact" description="Get in touch with Ari Ben-Ami.">
  <h1>Contact</h1>
  <p class="lede">Email is best. I read everything.</p>
  <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
  <p><a href={site.linkedin}>LinkedIn</a></p>
  <p>If you want to talk about a project, a role, or something I wrote, send a note and I'll reply with a few times that work.</p>
</Base>
