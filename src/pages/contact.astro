---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Contact" description="Get in touch with Ari Ben-Ami.">
  <h1>Contact</h1>
  <p class="lede">Email is best. I read everything.</p>
  <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
  <p><a href={site.linkedin}>LinkedIn</a></p>
  <p>I'm open to full-time roles in design, product or marketing, and I take a small number of consulting projects: brand and packaging, product and UX, marketing systems, retail analytics and pricing.</p>
  <p class="todo">TODO: decide on a short form or a Calendly link, and the personal email address.</p>
</Base>
