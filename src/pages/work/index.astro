---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

// One card per case study, newest era first, then by order.
const all = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => {
  if (a.data.era !== b.data.era) return a.data.era === '2024–now' ? -1 : 1;
  return a.data.order - b.data.order;
});
---
<Base title="Work" description="Case studies: things I designed, built, and then checked the numbers on.">
  <h1>Work</h1>
  <p class="lede">Things I designed, built, and then checked the numbers on.</p>

  <div class="grid">
    {all.map((cs) => (
      <a class="card" href={`/work/${cs.id}`}>
        {cs.data.cover && <img class="cover" src={cs.data.cover} alt="" loading="lazy" />}
        <div class="meta">{cs.data.organization} · {cs.data.period}</div>
        <h3>{cs.data.title}</h3>
        <p class="muted">{cs.data.summary}</p>
      </a>
    ))}
  </div>
</Base>
