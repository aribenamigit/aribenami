---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} description={d.summary}>
  <p class="muted">{d.organization} · {d.period} · {d.areas.join(', ')}</p>
  <h1>{d.title}</h1>
  <p class="lede">{d.summary}</p>
  <p class="muted">Role: {d.role}</p>
  {d.outcomes.length > 0 && (
    <div class="stats">
      {d.outcomes.map((o) => (
        <div><strong>{o.value}</strong><span>{o.label}</span></div>
      ))}
    </div>
  )}
  <div class="tags">
    {d.tags.map((t) => <a class="tag" href={`/writing?tag=${t}`}>{t}</a>)}
  </div>
  {d.cover && <img class="hero" src={d.cover} alt={d.coverAlt ?? ""} />}
  <article class="prose">
    <Content />
  </article>
  <p><a href="/work">← All work</a></p>
</Base>
