---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';

// All case studies are rendered; a small script shows three at random on each visit.
const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'short' });
---
<Base>
  <p class="muted">{site.name}, {site.location}</p>
  <h1>{site.tagline}</h1>
  <div class="lede">
    <p>A well designed email gets more clicks. Well designed packaging sells more units. A well designed menu gets read. A well designed store gets walked through. A well designed price gets paid without a second thought.</p>
    <p>The same test applies to things you can't see. A loyalty program is designed. A discount schedule is designed. A business model is designed, with the same tools and the same judgment as a logo, and it gets verified the same way: people want it, or they don't.</p>
    <p>{site.subline}</p>
  </div>

  <h2>Jump into my work</h2>
  <div class="grid" id="work-grid">
    {work.map((cs) => (
      <a class="card" href={`/work/${cs.id}`} hidden>
        {cs.data.cover && <img class="cover" src={cs.data.cover} alt="" loading="lazy" />}
        <div class="meta">{cs.data.organization} · {cs.data.period}</div>
        <h3>{cs.data.title}</h3>
        <p class="muted">{cs.data.summary}</p>
      </a>
    ))}
  </div>
  <p><a href="/work">Explore other topics</a></p>

  <h2>Writing</h2>
  <p>This is my corner. I write about whatever I'm thinking about: design, business, chess, investing, mechanical watches, NBA basketball, cannabis in California, and the lessons I pick up at work. Short posts, one idea each.</p>
  <ul class="list">
    {posts.map((p) => (
      <li>
        <a href={`/writing/${p.id}`}>{p.data.title}</a>
        <div class="muted">{fmt(p.data.date)} · {p.data.description}</div>
        <a class="more" href={`/writing/${p.id}`}>Read more →</a>
      </li>
    ))}
  </ul>
  <p><a href="/writing">All writing</a></p>

  <h2>What I work on</h2>
  <p>Marketing, which means the budget and everything it pays for: brand, campaigns, pricing and promotions, loyalty, sponsorships, the website, the screens in the store, and the numbers that say whether any of it worked. I design most of it and build a good share of it myself. On the side I consult for other businesses and startups on brand and product.</p>

  <h2>Now</h2>
  <p>Running marketing for a dispensary in the Sierra foothills. Helping a few early-stage teams with brand and product on the side. Building this site at night. Reading chess books and losing to people rated 1600 anyway. <span class="muted">Updated {site.nowUpdated}.</span></p>

  <p><a class="btn" href="/contact">Get in touch</a></p>

  <script>
    const cards = [...document.querySelectorAll<HTMLElement>('#work-grid .card')];
    for (let i = cards.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [cards[i], cards[j]] = [cards[j], cards[i]];
    }
    cards.slice(0, 3).forEach((c) => (c.hidden = false));
  </script>
</Base>
