---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const roles = [
  {
    years: '2024–now',
    title: 'Marketing Manager',
    org: 'Grass Valley Provisions, Grass Valley CA',
    text: 'The whole marketing department: budget, brand, campaigns, pricing, loyalty, sponsorships, website, in-store screens, and the numbers.',
  },
  {
    years: '2021–now',
    title: 'Consultant',
    org: 'Independent',
    text: 'Brand and product for other businesses and startups.',
  },
  {
    years: '2021–2024',
    title: 'Co-founder & Chief Product Officer',
    org: 'Prosper Technology Solutions',
    text: 'Designed and shipped a venture-funded referral marketing product for Shopify stores, leading 3 designers and 4 developers.',
  },
  {
    years: '2021–2022',
    title: 'Graphic Designer',
    org: 'Modernistic, Stillwater MN',
    text: 'First in-house graphic designer at a print manufacturer serving Fortune 500 clients, hired during its rebrand.',
  },
];
---
<Base title="Experience" description="Ari Ben-Ami: Marketing Manager at Grass Valley Provisions, former co-founder and CPO at Prosper.">
  <h1>Experience</h1>
  <p class="lede">{site.name}. {site.location}.</p>

  <ul class="timeline">
    {roles.map((r) => (
      <li>
        <div class="years">{r.years}</div>
        <div>
          <strong>{r.title}</strong>, {r.org}
          <p>{r.text}</p>
        </div>
      </li>
    ))}
  </ul>

  <h2>Education</h2>
  <ul class="timeline">
    <li>
      <div class="years">2018–2022</div>
      <div><strong>BFA Graphic Design & Interactive Media</strong><p>University of Wisconsin-Stout</p></div>
    </li>
  </ul>
</Base>
